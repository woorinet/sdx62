[Unit]
SourcePath=/usr/bin/ipacmdiag
Description= IPACM DIAG Service
Wants=diag-reboot-app.service diag-router.service
After=diag-reboot-app.service diag-router.service

[Service]
Restart=no
ExecStart=/usr/bin/ipacmdiag
User=radio
Group=radio
SupplementaryGroups=diag inet

[Install]
WantedBy=multi-user.target
