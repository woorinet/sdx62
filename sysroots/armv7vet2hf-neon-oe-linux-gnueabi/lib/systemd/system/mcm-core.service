[Unit]
Description= MCM RIL Services
SourcePath=/usr/bin/mcm_ril_service

[Service]
User=mcm
Group=mcm
Restart=no
ExecStart=/usr/bin/mcm_ril_service
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_SETUID CAP_SETGID CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

