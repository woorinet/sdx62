[Unit]
SourcePath=/usr/bin/woorinetapp
Description=Woorinet Service
After=mount-data.service

[Service]
User=radio
Group=radio
Restart=always
ExecStart=/usr/bin/woorinetapp
ExecStop=/usr/bin/killall -QUIT woorinetapp
SupplementaryGroups=diag inet net_admin system wifi netdev net_raw kmsg locclient adb

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target