#!/bin/sh
# Expected to be called as: depmodwrapper -a KERNEL_VERSION
if [ "$1" != "-a" -o "$2" != "-b" ]; then
    echo "Usage: depmodwrapper -a -b rootfs KERNEL_VERSION" >&2
    exit 1
fi

kernelabi=""
if [ -r "/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata/sdxlemur/kernel-depmod/kernel-abiversion" ]; then
    kernelabi=$(cat "/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata/sdxlemur/kernel-depmod/kernel-abiversion")
fi

if [ ! -r /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata/sdxlemur/kernel-depmod/System.map-$4 ] || [ "$kernelabi" != "$4" ]; then
    echo "Unable to read: /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata/sdxlemur/kernel-depmod/System.map-$4" >&2
    exec env depmod "$1" "$2" "$3" "$4"
else
    exec env depmod "$1" "$2" "$3" -F "/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata/sdxlemur/kernel-depmod/System.map-$4" "$4"
fi
