	if [ -p /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/sdxlemur-oe-linux-gnueabi/build-sysroots/1.0-r0/temp/fifo.1901 ] ; then
		printf "%b\0" "bbfatal $*" > /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/sdxlemur-oe-linux-gnueabi/build-sysroots/1.0-r0/temp/fifo.1901
	else
		echo "ERROR: $*"
	fi
	exit 1
}

