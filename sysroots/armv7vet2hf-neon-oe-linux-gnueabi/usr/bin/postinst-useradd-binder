useradd_sysroot() {
	# Pseudo may (do_prepare_recipe_sysroot) or may not (do_populate_sysroot_setscene) be running
	# at this point so we're explicit about the environment so pseudo can load if
	# not already present.
	# PSEUDO_SYSROOT can contain references to the build architecture and COMPONENT_DIR
	# so needs the STAGING_FIXME below
	export PSEUDO="PSEUDO_PREFIX=/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots-components/x86_64/pseudo-native/usr PSEUDO_LOCALSTATEDIR=/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/sdxlemur-oe-linux-gnueabi/build-sysroots/1.0-r0/pseudo/ PSEUDO_PASSWD=/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots/sdxlemur:/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots-components/x86_64/pseudo-native PSEUDO_NOSYMLINKEXP=1 PSEUDO_IGNORE_PATHS=/usr/,/etc/,/lib,/dev/,/run/,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/temp,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots/sdxlemur,/opt/sdx65/apps_proc/sstate-cache,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/stamps,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sstate-control,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/buildstats,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots-components,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/pkgdata,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/deploy-,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/sstate-build-package_,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/sstate-install-package_,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/pkgdata-sysroot,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/deploy,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/buildhistory,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/cache,/opt/sdx65/apps_proc/poky/scripts,/opt/sdx65/apps_proc/poky/meta/files/common-licenses,/opt/sdx65/apps_proc/poky/meta-qti-bsp-prop/files/qcom-licenses,/opt/sdx65/apps_proc/poky/meta-qti-bsp/files/common-licenses,/opt/sdx65/apps_proc/poky/meta-openembedded/meta-python/licenses,/opt/sdx65/apps_proc/poky/meta-openembedded/meta-oe/licenses,/opt/sdx65/apps_proc/poky/meta-openembedded/meta-multimedia/licenses,/opt/sdx65/apps_proc/poky/meta-openembedded/meta-networking/licenses,/opt/sdx65/apps_proc/poky/meta-gplv2/licenses,/opt/sdx65/apps_proc/poky/meta/COPYING,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/binder,/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/armv7vet2hf-neon-oe-linux-gnueabi/binder/git-r0/build PSEUDO_DISABLED=0 /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots-components/x86_64/pseudo-native/usr/bin/pseudo"

	# Explicitly set $D since it isn't set to anything
	# before do_prepare_recipe_sysroot
	D=/opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/sysroots/sdxlemur

	# base-passwd's postinst may not have run yet in which case we'll get called later, just exit.
	# Beware that in some cases we might see the fake pseudo passwd here, in which case we also must
	# exit.
	if [ ! -f $D/etc/passwd ] ||
			grep -q this-is-the-pseudo-passwd $D/etc/passwd; then
		exit 0
	fi

	# It is also possible we may be in a recipe which doesn't have useradd dependencies and hence the
	# useradd/groupadd tools are unavailable. If there is no dependency, we assume we don't want to
	# create users in the sysroot
	if ! command -v useradd; then
		bbwarn "command useradd not found!"
		exit 0
	fi

	# Add groups and users defined for all recipe packages
	GROUPADD_PARAM="                         -g 2901 kmsg; 			-g 3004 net_raw; 			-g 3005 net_admin; 			-g 3009 readproc; 			-g 3010 wakelock; 			-g 3013 qwes; 			-g 3018 gpio; 			"
	USERADD_PARAM=" 			-u 5002 -U leprop; 			-u 1000 -U system; 			-u 1001 -U radio; 			-G leprop -u 1002 -U bluetooth; 			-u 1003 -U graphics; 			-u 1004 -g input input; 			-G diag,system -u 1005 -g audio audio; 			-G inet,system,leprop -u 1006 -U camera; 			-u 1010 -U wifi; 			-u 1013 -U media; 			-u 1036 -U logd; 			-u 2000 -U adb; 			-G diag,inet,system,leprop -u 3011 -U sensors; 			-u 4000 -U apps; 			-u 9999 -U nobody; 			-G audio,camera,system,leprop,video -u 5000 -U qmmfsvr; 			-G audio,camera,input,system,inet,leprop,video -u 5001 -U qmmfwebsvr; 			-G audio,camera,input,system,inet,leprop,video -u 5003 -U ipcwebsvr; 			-u 4021 -U locclient; 			-G system,locclient -u 1021 -U gps; 			-G system,diag,radio -u 4023 -U mcm; 			-u 3014 -U powermgr; 			-u 3015 -U ubi; 			-u 2906 -U qrtr; 			"
	GROUPMEMS_PARAM=""

	# Tell the system to use the environment vars
	UA_SYSROOT=1

	useradd_preinst
}

bbwarn() {
	if [ -p /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/sdxlemur-oe-linux-gnueabi/build-sysroots/1.0-r0/temp/fifo.1901 ] ; then
		printf "%b\0" "bbwarn $*" > /opt/sdx65/apps_proc/build-qti-distro-nogplv3-debug/tmp-glibc/work/sdxlemur-oe-linux-gnueabi/build-sysroots/1.0-r0/temp/fifo.1901
	else
		echo "WARNING: $*"
	fi
}

useradd_preinst() {
OPT=""
SYSROOT=""

if test "x$D" != "x"; then
	# Installing into a sysroot
	SYSROOT="$D"
	OPT="--root $D"

	# Make sure login.defs is there, this is to make debian package backend work
	# correctly while doing rootfs.
	# The problem here is that if /etc/login.defs is treated as a config file for
	# shadow package, then while performing preinsts for packages that depend on
	# shadow, there might only be /etc/login.def.dpkg-new there in root filesystem.
	if [ ! -e $D/etc/login.defs -a -e $D/etc/login.defs.dpkg-new ]; then
	    cp $D/etc/login.defs.dpkg-new $D/etc/login.defs
	fi

	# user/group lookups should match useradd/groupadd --root
	export PSEUDO_PASSWD="$SYSROOT"
fi

# If we're not doing a special SSTATE/SYSROOT install
# then set the values, otherwise use the environment
if test "x$UA_SYSROOT" = "x"; then
	# Installing onto a target
	# Add groups and users defined only for this package
	GROUPADD_PARAM="${GROUPADD_PARAM}"
	USERADD_PARAM="${USERADD_PARAM}"
	GROUPMEMS_PARAM="${GROUPMEMS_PARAM}"
fi

# Perform group additions first, since user additions may depend
# on these groups existing
if test "x`echo $GROUPADD_PARAM | tr -d '[:space:]'`" != "x"; then
	echo "Running groupadd commands..."
	# Invoke multiple instances of groupadd for parameter lists
	# separated by ';'
	opts=`echo "$GROUPADD_PARAM" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
	remaining=`echo "$GROUPADD_PARAM" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	while test "x$opts" != "x"; do
		perform_groupadd "$SYSROOT" "$OPT $opts"
		if test "x$opts" = "x$remaining"; then
			break
		fi
		opts=`echo "$remaining" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
		remaining=`echo "$remaining" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	done
fi

if test "x`echo $USERADD_PARAM | tr -d '[:space:]'`" != "x"; then
	echo "Running useradd commands..."
	# Invoke multiple instances of useradd for parameter lists
	# separated by ';'
	opts=`echo "$USERADD_PARAM" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
	remaining=`echo "$USERADD_PARAM" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	while test "x$opts" != "x"; do
		perform_useradd "$SYSROOT" "$OPT $opts"
		if test "x$opts" = "x$remaining"; then
			break
		fi
		opts=`echo "$remaining" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
		remaining=`echo "$remaining" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	done
fi

if test "x`echo $GROUPMEMS_PARAM | tr -d '[:space:]'`" != "x"; then
	echo "Running groupmems commands..."
	# Invoke multiple instances of groupmems for parameter lists
	# separated by ';'
	opts=`echo "$GROUPMEMS_PARAM" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
	remaining=`echo "$GROUPMEMS_PARAM" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	while test "x$opts" != "x"; do
		perform_groupmems "$SYSROOT" "$OPT $opts"
		if test "x$opts" = "x$remaining"; then
			break
		fi
		opts=`echo "$remaining" | cut -d ';' -f 1 | sed -e 's#[ \t]*$##'`
		remaining=`echo "$remaining" | cut -d ';' -f 2- | sed -e 's#[ \t]*$##'`
	done
fi
}

perform_groupadd() {
	local rootdir="$1"
	local opts="$2"
	bbnote "binder: Performing groupadd with [$opts]"
	local groupname=`echo "$opts" | awk '{ print $NF }'`
	local group_exists="`grep "^$groupname:" $rootdir/etc/group || true`"
	if test "x$group_exists" = "x"; then
		eval flock -x $rootdir/etc -c \"$PSEUDO groupadd \$opts\" || true
		group_exists="`grep "^$groupname:" $rootdir/etc/group || true`"
		if test "x$group_exists" = "x"; then
			bbfatal "binder: groupadd command did not succeed."
		fi
	else
		bbnote "binder: group $groupname already exists, not re-creating it"
	fi
}

perform_groupmems() {
	local rootdir="$1"
	local opts="$2"
	bbnote "binder: Performing groupmems with [$opts]"
	local groupname=`echo "$opts" | awk '{ for (i = 1; i < NF; i++) if ($i == "-g" || $i == "--group") print $(i+1) }'`
	local username=`echo "$opts" | awk '{ for (i = 1; i < NF; i++) if ($i == "-a" || $i == "--add") print $(i+1) }'`
	bbnote "binder: Running groupmems command with group $groupname and user $username"
	local mem_exists="`grep "^$groupname:[^:]*:[^:]*:\([^,]*,\)*$username\(,[^,]*\)*$" $rootdir/etc/group || true`"
	if test "x$mem_exists" = "x"; then
		eval flock -x $rootdir/etc -c \"$PSEUDO groupmems \$opts\" || true
		mem_exists="`grep "^$groupname:[^:]*:[^:]*:\([^,]*,\)*$username\(,[^,]*\)*$" $rootdir/etc/group || true`"
		if test "x$mem_exists" = "x"; then
			bbfatal "binder: groupmems command did not succeed."
		fi
	else
		bbnote "binder: group $groupname already contains $username, not re-adding it"
	fi
}

perform_useradd() {
	local rootdir="$1"
	local opts="$2"
	bbnote "binder: Performing useradd with [$opts]"
	local username=`echo "$opts" | awk '{ print $NF }'`
	local user_exists="`grep "^$username:" $rootdir/etc/passwd || true`"
	if test "x$user_exists" = "x"; then
		eval flock -x $rootdir/etc -c  \"$PSEUDO useradd \$opts\" || true
		user_exists="`grep "^$username:" $rootdir/etc/passwd || true`"
		if test "x$user_exists" = "x"; then
			bbfatal "binder: useradd command did not succeed."
		fi
	else
		bbnote "binder: user $username already exists, not re-creating it"
	fi
}

