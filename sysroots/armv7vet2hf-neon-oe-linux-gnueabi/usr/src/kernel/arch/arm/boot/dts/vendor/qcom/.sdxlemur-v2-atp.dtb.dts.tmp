 };

 pdc: interrupt-controller@b210000 {
  compatible = "qcom,sdxlemur-pdc";
  reg = <0xb210000 0x10000>;
  qcom,pdc-ranges = <0 147 52>, <52 266 32>;
  #interrupt-cells = <2>;
  interrupt-parent = <&intc>;
  interrupt-controller;
 };


 gcc_pcie_gdsc: qcom,gdsc@143004 {
