  uart3_console_active: uart3_console_active {
   mux {
    pins = "gpio8", "gpio9";
    function = "blsp_uart3";
   };

   config {
    pins = "gpio8", "gpio9";
    drive-strength = <2>;
    bias-disable;
    };
   };

  uart3_console_sleep: uart3_console_sleep {
   mux {
    pins = "gpio8", "gpio9";
    function = "blsp_uart3";
   };

   config {
    pins = "gpio8", "gpio9";
    drive-strength = <2>;
    bias-disable;
   };
  };

