# 2 "/home/pkang/sdx62/apps_proc/build-qti-distro-nogplv3-perf/tmp-glibc/work-shared/sdxlemur/kernel-source/arch/arm/boot/dts/vendor/qcom/sdxlemur-ion.dtsi" 2

&soc {
 qcom,ion {
  compatible = "qcom,msm-ion";
  #address-cells = <1>;
  #size-cells = <0>;

  system_heap: qcom,ion-heap@25 {
   reg = <(1U << (25))>;
   qcom,ion-heap-type = "MSM_SYSTEM";
  };

  audio_co_heap: qcom,ion-heap@17 {
   reg = <(1U << (17))>;
   qcom,ion-heap-type = "MSM_CARVEOUT";




   status = "disabled";
  };

  qcom,ion-heap@27 {
   reg = <(1U << (7))>;
   memory-region = <&qseecom_mem>;
   qcom,ion-heap-type = "DMA";
  };

  qcom,ion-heap@19 {
   reg = <(1U << (1))>;
   memory-region = <&qseecom_ta_mem>;
   qcom,ion-heap-type = "DMA";
  };
 };
};
