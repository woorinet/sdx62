# 9 "/home/pkang/sdx62/apps_proc/build-qti-distro-nogplv3-perf/tmp-glibc/work-shared/sdxlemur/kernel-source/arch/arm/boot/dts/vendor/qcom/sdxlemur-atp.dtsi" 2
 };
};

&usb {
 extcon = <&pm7250b_pdphy>, <&eud>;

 #io-channel-cells = <1>;
 io-channels= <&pm7250b_charger 0x0a>;
 io-channel-names = "chg_type";
};

&vbus_detect {
 status = "disabled";
};

&pm7250b_clkdiv {
 clocks = <&rpmhcc 0>;
 clock-names = "xo";
};

&pm7250b_vadc {
 charger_skin_therm {
  reg = <0x4d>;
  label = "charger_skin_therm";
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  qcom,pre-scaling = <1 1>;
 };

 conn_therm {
  reg = <0x4f>;
  label = "conn_therm";
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
  qcom,pre-scaling = <1 1>;
 };

 smb1390_therm@e {
  qcom,scale-fn-type = <15>;
 };
};

&pm7250b_charger {
 #io-channel-cells = <1>;
 io-channels = <&pm7250b_vadc 0x08>,
        <&pm7250b_vadc 0x07>,
        <&pm7250b_vadc 0x09>,
        <&pm7250b_vadc 0x06>,
        <&pm7250b_vadc 0x4f>,
        <&pm7250b_vadc 0x99>,
        <&pm7250b_vadc 0x83>,
        <&pm7250b_vadc 0x4d>,
        <&pm7250b_qg 0x4b>,
        <&pm7250b_qg 0x46>,
        <&pm7250b_qg 0x45>,
        <&pm7250b_qg 0x42>,
        <&pm7250b_qg 0x47>,
        <&pm7250b_qg 0x5d>,
        <&pm7250b_qg 0x4e>,
        <&pm7250b_qg 0x44>,
        <&pm7250b_qg 0x5b>,
        <&pm7250b_qg 0x48>,
        <&pm7250b_qg 0x2d>,
        <&pm7250b_qg 0x53>,
        <&pm7250b_qg 0x49>,
        <&pm7250b_qg 0x52>,
        <&pm7250b_qg 0x54>,
        <&pm7250b_qg 0x56>;
 io-channel-names = "usb_in_voltage",
      "usb_in_current",
      "chg_temp",
      "die_temp",
      "conn_temp",
      "sbux_res",
      "vph_voltage",
      "skin_temp",
      "resistance_id",
      "voltage_now",
      "temp",
      "capacity",
      "voltage_ocv",
      "voltage_avg",
      "debug_battery",
      "real_capacity",
      "cc_soc",
      "current_now",
      "voltage_max",
      "charge_full",
      "charge_counter",
      "cycle_count",
      "charge_full_design",
      "time_to_full_now";
 qcom,battery-data = <&atp_batterydata>;
 qcom,auto-recharge-soc = <98>;
 qcom,step-charging-enable;
 qcom,sw-jeita-enable;
 qcom,charger-temp-max = <800>;
 qcom,smb-temp-max = <800>;
 qcom,suspend-input-on-debug-batt;
 qcom,fcc-stepping-enable;
 qcom,fcc-step-delay-ms = <100>;
 qcom,fcc-step-size-ua = <100000>;
 qcom,thermal-mitigation = <3600000 3000000 1500000 1000000 500000>;
 qcom,smb-internal-pull-kohm = <0>;
 qcom,en-skin-therm-mitigation;
 qcom,hvdcp3-standalone-config;
 dpdm-supply = <&usb2_phy>;

 smb5_vbus: qcom,smb5-vbus {
  regulator-name = "smb5-vbus";
 };

 smb5_vconn: qcom,smb5-vconn {
  regulator-name = "smb5-vconn";
 };
};

&pm7250b_qg {
 #io-channel-cells = <1>;
 io-channels = <&pm7250b_vadc 0x4a>,
        <&pm7250b_vadc 0x4b>,
        <&pm7250b_charger 0x37>,
        <&pm7250b_charger 0x3f>,
        <&pm7250b_charger 0x40>,
        <&pm7250b_charger 0x39>;
 io-channel-names = "batt-therm",
      "batt-id",
      "input_current_limited",
      "recharge_soc",
      "force_recharge",
      "charge_done";
 qcom,battery-data = <&atp_batterydata>;
 qcom,qg-iterm-ma = <150>;
 qcom,hold-soc-while-full;
 qcom,linearize-soc;
 qcom,cl-feedback-on;
 qcom,tcss-enable;
 qcom,fvss-enable;
 qcom,fvss-vbatt-mv = <3300>;
 qcom,bass-enable;
};

&pm7250b_pdphy {
 vdd-pdphy-supply = <&L10B>;
 vbus-supply = <&smb5_vbus>;
 vconn-supply = <&smb5_vconn>;

 #io-channel-cells = <1>;
 io-channels = <&pm7250b_charger 0x04>,
        <&pm7250b_charger 0x03>,
        <&pm7250b_charger 0x0d>,
        <&pm7250b_charger 0x02>,
        <&pm7250b_charger 0x1f>,
        <&pm7250b_charger 0x1d>,
        <&pm7250b_charger 0x1e>,
        <&pm7250b_charger 0x00>,
        <&pm7250b_charger 0x20>,
        <&pm7250b_charger 0x0c>,
        <&pm7250b_charger 0x0b>,
        <&pm7250b_charger 0x0a>,
        <&pm7250b_charger 0x01>,
        <&pm7250b_charger 0x07>;
 io-channel-names = "pd_active",
      "typec_cc_orientation",
      "connector_type",
      "typec_power_role",
      "pd_usb_suspend_supported",
      "typec_src_rp",
      "pd_in_hard_reset",
      "pr_current_max",
      "pr_swap",
      "pd_voltage_min",
      "pd_voltage_max",
      "real_type",
      "typec_mode",
      "pe_start";
};

&pm7250b_adc_tm {
 io-channels = <&pm7250b_vadc 0x4d>,
   <&pm7250b_vadc 0x4f>;

 charger_skin_therm {
  reg = <0x4d>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };

 conn_therm {
  reg = <0x4f>;
  qcom,ratiometric;
  qcom,hw-settle-time = <200>;
 };
};

&thermal_zones {
 chg-skin-therm-usr {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "user_space";
  thermal-sensors = <&pm7250b_adc_tm 0x4d>;
  trips {
   active-config0 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };

   active-config1 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };
  };
 };

 conn-therm-usr {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "user_space";
  thermal-sensors = <&pm7250b_adc_tm 0x4f>;
  trips {
   active-config0 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };

   active-config1 {
    temperature = <125000>;
    hysteresis = <1000>;
    type = "passive";
   };
  };
 };
};
