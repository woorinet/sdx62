# 1 "/home/pkang/sdx62/apps_proc/build-qti-distro-nogplv3-perf/tmp-glibc/work-shared/sdxlemur/kernel-source/arch/arm/boot/dts/vendor/qcom/msm-arm-smmu-sdxlemur.dtsi" 1


&soc {
  apps_smmu: apps-smmu@15000000 {
  compatible = "qcom,qsmmu-v500";
  reg = <0x15000000 0x40000>,
   <0x15042000 0x20>;
  reg-names = "base", "tcu-base";
  #iommu-cells = <2>;
  qcom,skip-init;
  qcom,use-3-lvl-tables;
  #global-interrupts = <1>;
  #size-cells = <1>;
  #address-cells = <1>;
  ranges;
  interrupts = <0 65 4>,
    <0 70 4>,
    <0 71 4>,
    <0 72 4>,
    <0 73 4>,
    <0 94 4>,
    <0 95 4>,
    <0 96 4>,
    <0 97 4>,
    <0 98 4>,
    <0 99 4>,
    <0 100 4>,
    <0 101 4>,
    <0 102 4>,
    <0 103 4>,
    <0 104 4>,
    <0 105 4>,
    <0 106 4>,
    <0 107 4>,
    <0 108 4>,
    <0 109 4>,
    <0 110 4>,
    <0 298 4>,
    <0 299 4>,
    <0 300 4>,
    <0 301 4>,
    <0 302 4>,
    <0 303 4>,
    <0 304 4>,
    <0 305 4>,
    <0 306 4>,
    <0 307 4>,
    <0 308 4>;

  interconnects = <&mem_noc 14
     &system_noc 521>;
  qcom,active-only;

  periph_tbu: periph_tbu@15045000 {
   compatible = "qcom,qsmmuv500-tbu";
   reg = <0x15045000 0x1000>,
    <0x15042200 0x8>;
   reg-names = "base", "status-reg";
   qcom,stream-id-range = <0x0 0x400>;
   interconnects = <&mem_noc 14
      &system_noc 521>;
   qcom,active-only;
   qcom,opt-out-tbu-halting;
  };

  ipa_tbu: ipa_tbu@15049000 {
   compatible = "qcom,qsmmuv500-tbu";
   reg = <0x15049000 0x1000>,
    <0x15042208 0x8>;
   reg-names = "base", "status-reg";
   qcom,stream-id-range = <0x400 0x400>;
   interconnects = <&mem_noc 14
      &system_noc 521>;
   qcom,active-only;
  };
 };

 apps_iommu_test_device {
  status = "disabled";
  compatible = "iommu-debug-test";
  iommus = <&apps_smmu 0x100 0>;
  qcom,iommu-dma = "disabled";
 };

 apps_iommu_coherent_test_device {
  status = "disabled";
  compatible = "iommu-debug-test";
  iommus = <&apps_smmu 0x101 0>;
  qcom,iommu-dma = "disabled";
  dma-coherent;
 };
};
