&spmi_bus {
 #address-cells = <2>;
 #size-cells = <0>;
 interrupt-controller;
 #interrupt-cells = <4>;

 pmk8350: qcom,pmk8350@0 {
  compatible = "qcom,spmi-pmic";
  reg = <0 0>;
  #address-cells = <1>;
  #size-cells = <0>;

  pon_pbs@800 {
   compatible = "qcom,qpnp-power-on";
   reg = <0x800>;
   qcom,system-reset;
   qcom,store-hard-reset-reason;
  };

  pon_hlos@1300 {
   compatible = "qcom,qpnp-power-on";
   reg = <0x1300>, <0x800>;
   reg-names = "pon_hlos", "pon_pbs";
   interrupts = <0x0 0x13 0x7 (2 | 1)>,
         <0x0 0x13 0x6 (2 | 1)>;
   interrupt-names = "kpdpwr", "resin";
   qcom,kpdpwr-sw-debounce;

   qcom,pon_1 {
    qcom,pon-type = <0>;
    linux,code = <116>;
   };

   qcom,pon_2 {
    qcom,pon-type = <1>;
    linux,code = <114>;
   };
  };

  pmk8350_vadc: vadc@3100 {
   compatible = "qcom,spmi-adc7";
   reg = <0x3100>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <0x0 0x31 0x0 1>;
   interrupt-names = "eoc-int-en-set";
   #io-channel-cells = <1>;
   io-channel-ranges;


   pmk8350_ref_gnd {
    reg = <(0 << 8 | 0x0)>;
    label = "pmk8350_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_vref_1p25 {
    reg = <(0 << 8 | 0x01)>;
    label = "pmk8350_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_die_temp {
    reg = <(0 << 8 | 0x03)>;
    label = "pmk8350_die_temp";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_xo_therm {
    reg = <(0 << 8 | 0x44)>;
    label = "pmk8350_xo_therm";
    qcom,ratiometric;
    qcom,hw-settle-time = <200>;
    qcom,pre-scaling = <1 1>;
   };


   pm8350_ref_gnd {
    reg = <(1 << 8 | 0x0)>;
    label = "pm8350_ref_gnd";
