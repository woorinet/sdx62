# 2 "/home/pkang/sdx62/apps_proc/build-qti-distro-nogplv3-perf/tmp-glibc/work-shared/sdxlemur/kernel-source/arch/arm/boot/dts/vendor/qcom/sdxlemur-usb.dtsi" 2

&soc {
 usb: ssusb@a600000 {
  compatible = "qcom,dwc-usb3-msm";
  reg = <0x0a600000 0x100000>;
  reg-names = "core_base";

  iommus = <&apps_smmu 0x1a0 0x0>;
  qcom,iommu-dma = "atomic";
  qcom,iommu-dma-addr-pool = <0x90000000 0x0ffe0000>;
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;
  dma-ranges;
  qcom,iommu-best-fit-algo;

  interrupts-extended = <&pdc 19 1>,
    <&intc 0 130 4>,
    <&pdc 76 4>,
    <&pdc 18 1>;
  interrupt-names = "dp_hs_phy_irq", "pwr_event_irq",
    "ss_phy_irq", "dm_hs_phy_irq";
  qcom,use-pdc-interrupts;

  USB3_GDSC-supply = <&gcc_usb30_gdsc>;
  dpdm-supply = <&usb2_phy>;
  qcom,usb-charger;
  clocks = <&gcc 65>,
   <&gcc 72>,
   <&gcc 70>,
   <&gcc 67>,
   <&gcc 71>,
   <&gcc 77>;
  clock-names = "core_clk", "iface_clk", "bus_aggr_clk",
     "utmi_clk", "sleep_clk", "xo";

  resets = <&gcc 20>;
  reset-names = "core_reset";

  qcom,core-clk-rate = <200000000>;
  qcom,core-clk-rate-hs = <66666667>;
  qcom,num-gsi-evt-buffs = <0x3>;
  qcom,gsi-reg-offset =
   <0x0fc
    0x208
    0x224
    0x240
    0x25c
    0x1a4>;
  qcom,dwc-usb3-msm-tx-fifo-size = <27696>;

  interconnect-names = "usb-ddr", "usb-ipa", "ddr-usb";
  interconnects = <&system_noc 19 &mc_virt 512>,
    <&system_noc 19 &system_noc 522>,
    <&mem_noc 14 &system_noc 535>;

  qcom,default-bus-vote = <2>;
  qcom,pm-qos-latency = <44>;
  dwc3@a600000 {
   compatible = "snps,dwc3";
   reg = <0x0a600000 0xcd00>;
   interrupts = <0 133 4>;
   usb-phy = <&usb2_phy>, <&usb_qmp_phy>;
   linux,sysdev_is_parent;
   snps,disable-clk-gating;
   snps,has-lpm-erratum;
   snps,hird-threshold = /bits/ 8 <0x10>;
   snps,ssp-u3-u0-quirk;
   snps,dis-u1-entry-quirk;
   snps,dis-u2-entry-quirk;
   snps,bus-suspend-enable;
   tx-fifo-resize;
   maximum-speed = "super-speed-plus";
   dr_mode = "otg";
   imod-interval-ns = <1000000>;
  };

  qcom,usbbam@a704000 {
   compatible = "qcom,usb-bam-msm";
   reg = <0xa704000 0x17000>;
   interrupts = <0 132 4>;

   qcom,usb-bam-fifo-baseaddr = <0x1468b000>;
   qcom,usb-bam-num-pipes = <4>;
   qcom,disable-clk-gating;
   qcom,usb-bam-override-threshold = <0x4001>;
   qcom,usb-bam-max-mbps-highspeed = <400>;
   qcom,usb-bam-max-mbps-superspeed = <3600>;
   qcom,reset-bam-on-connect;

   qcom,pipe0 {
    label = "ssusb-qdss-in-0";
    qcom,usb-bam-mem-type = <2>;
    qcom,dir = <1>;
    qcom,pipe-num = <0>;
    qcom,peer-bam = <0>;
    qcom,peer-bam-physical-address = <0x6064000>;
    qcom,src-bam-pipe-index = <0>;
    qcom,dst-bam-pipe-index = <0>;
    qcom,data-fifo-offset = <0x0>;
    qcom,data-fifo-size = <0x1800>;
    qcom,descriptor-fifo-offset = <0x1800>;
    qcom,descriptor-fifo-size = <0x800>;
   };
  };
 };

 usb_nop_phy: usb_nop_phy {
  compatible = "usb-nop-xceiv";
 };

 usb2_phy: hsphy@ff4000 {
  compatible = "qcom,usb-hsphy-snps-femto";
  reg = <0xff4000 0x120>,
   <0xff2000 0x4>;
  reg-names = "hsusb_phy_base",
   "eud_enable_reg";
  vdd-supply = <&pmx65_l4>;
  qcom,vdd-voltage-level = <0 880000 912000>;
  vdda18-supply = <&pmx65_l5>;
  vdda33-supply = <&pmx65_l10>;

  clocks = <&rpmhcc 0>,
   <&gcc 78>;
  clock-names = "ref_clk_src", "cfg_ahb_clk";

  resets = <&gcc 16>;
  reset-names = "phy_reset";
  qcom,no-rext-present;
 };

 usb_qmp_phy: ssphy@ff6000 {
  compatible = "qcom,usb-ssphy-qmp-v2";
  reg = <0xff6000 0x2000>,
